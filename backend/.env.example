# ---- core ----
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/aegisfit
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENC_KEY=            # 64 hex chars (32 bytes) used to encrypt wearable OAuth tokens. openssl rand -hex 32
FRONTEND_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
REQUIRE_EMAIL_VERIFICATION=true

# ---- email (Nodemailer). Leave SMTP_HOST empty to use an Ethereal test inbox (preview link is printed) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AegisFit <no-reply@aegisfit.local>"

# ---- optional generative personalisation of plans ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- wearable OAuth apps (leave empty -> provider runs in sandbox/demo mode) ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
ALLOW_DEMO_WEARABLES=false      # true = unconfigured providers connect with 3 sample activities (dev only)

# ---- live price comparison (optional; without it the store shows pre-sorted retailer search links) ----
SERPAPI_KEY=
